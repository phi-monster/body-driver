      Runs      : constant := 100;
      Generator : Ada.Numerics.Float_Random.Generator;
      Worst     : Natural := 0;     --  the most pivots any moved program took
      Different : Natural := 0;     --  programs that took other pivots than the reference
      Unended   : Natural := 0;     --  programs that did not end as infeasible

      --  A number's last place.
      Unit : constant Real := Real'Epsilon;

      function Draw return Real is (2.0 * Real (Ada.Numerics.Float_Random.Random (Generator)) - 1.0);
   begin
      Check (Reference.Result = Infeasible, "the program the touches cannot hold reported " & Reference.Result'Image);
      Check (Reference.Pivots <= Rows * Columns,
             "the program took" & Reference.Pivots'Image & " pivots, more than it has cells");
      Ada.Numerics.Float_Random.Reset (Generator, 1);
      for Scale of Real_Array'[1.0, 16.0, 256.0] loop
         for Run in 1 .. Runs loop
            declare
               Moved_A    : Real_Matrix (1 .. Rows, 1 .. Columns) := A;
               Moved_B    : Real_Vector (1 .. Rows) := B;
               Moved_Cost : Real_Vector (1 .. Columns) := Cost;
            begin
               --  Every number moves by up to Scale units of its last place,
               --  drawn in this order.
               for I in 1 .. Rows loop
                  for J in 1 .. Columns loop
                     Moved_A (I, J) := A (I, J) * (1.0 + Scale * Unit * Draw);
                  end loop;
               end loop;
               for I in 1 .. Rows loop
                  Moved_B (I) := B (I) * (1.0 + Scale * Unit * Draw);
               end loop;
               for J in 1 .. Columns loop
                  Moved_Cost (J) := Cost (J) * (1.0 + Scale * Unit * Draw);
               end loop;
               declare
                  S : constant Solution := Minimize (Moved_A, Moved_B, Moved_Cost);
               begin
                  Worst := Natural'Max (Worst, S.Pivots);
                  if S.Result /= Infeasible then
                     Unended := Unended + 1;
                  end if;
                  if S.Pivots /= Reference.Pivots then
                     Different := Different + 1;
                  end if;
               end;
            end;
         end loop;
      end loop;
      Check (Unended = 0, Unended'Image & " programs moved by a few units of their last place did not end as the "
             & "program they were moved from");
      Check (Different = 0, Different'Image & " programs moved by a few units of their last place took other pivots"
             & " than" & Reference.Pivots'Image & ", up to" & Worst'Image);
      Check (Worst <= Rows * Columns, "a program took" & Worst'Image & " pivots, more than it has cells");
   end Noise_Does_Not_Decide;

   procedure Register is
   begin
      Driver.Tests.Register ("action.simplex.optimum", "the linear program misses the optimum of a small program",
                             Known_Optimum'Access);
      Driver.Tests.Register ("action.simplex.infeasible", "an impossible balance of forces is reported as possible",
                             Infeasible_Is_Said'Access);
      Driver.Tests.Register ("action.simplex.redundant", "dependent equalities make a possible balance look impossible",
                             Redundant_Rows'Access);
      Driver.Tests.Register ("action.simplex.degenerate", "a degenerate program cycles or stops short of its optimum",
                             Degenerate_Terminates'Access);
      Driver.Tests.Register ("action.simplex.noise", "the rounding noise of a degenerate vertex decides which row "
                             & "leaves, and the rule that cannot cycle goes round a cycle for ever",
                             Noise_Does_Not_Decide'Access);
   end Register;

end Driver.Action.Contact.Simplex.Tests;
