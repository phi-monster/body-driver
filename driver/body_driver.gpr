--  身体层驱动:一个可执行文件。编译:alr build;证明(监视器/备份/限位三段):alr exec -- gnatprove -P body_driver.gpr --level=2
project Body_Driver is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("body_driver.adb", "selfcheck.adb", "bodyexam.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-O2", "-g", "-gnatyM200");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=60");
   end Prove;
end Body_Driver;
