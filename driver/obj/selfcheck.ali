V "GNAT Lib v16"
M P W=b
A -O2
A -gnatA
A -gnat2022
A -gnata
A -gnatwa
A -g
A -gnatyM200
A -mmacosx-version-min=26.0.0
A -mcpu=apple-m1
A -mlittle-endian
A -mabi=lp64
A -fPIC
P SS ZX

