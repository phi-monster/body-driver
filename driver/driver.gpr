--  The body driver: one executable, its self test and the offline replay tool.
--  Build: alr build.  Prove the SPARK units: alr exec -- gnatprove -P driver.gpr
project Driver is
   for Source_Dirs use ("src/**", "tests", "tools");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("body_driver.adb", "selftest.adb", "replay.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatyg", "-gnatyM120", "-O2", "-g");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=60");
   end Prove;
end Driver;
