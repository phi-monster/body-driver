--  The body driver: one executable, its self test and the offline replay tool.
--  Build: alr build.  Prove the SPARK units: alr exec -- gnatprove -P driver.gpr
--  BD_BUILD=asan (alr build -- -XBD_BUILD=asan) builds the same programs with
--  AddressSanitizer into obj-asan and bin-asan, for the merge gate; the
--  normal build is untouched. BD_BUILD=profile builds them with -pg into
--  obj-profile and bin-profile: a run writes gmon.out for gprof (where the
--  time of the main task went, function by function).
project Driver is
   type Build_Kind is ("normal", "asan", "profile", "release", "fast");
   Build : Build_Kind := external ("BD_BUILD", "normal");

   for Source_Dirs use ("src/**", "tests", "tools");
   case Build is
      when "normal" =>
         for Object_Dir use "obj";
         for Exec_Dir use "bin";
      when "asan" =>
         for Object_Dir use "obj-asan";
         for Exec_Dir use "bin-asan";
      when "profile" =>
         for Object_Dir use "obj-profile";
         for Exec_Dir use "bin-profile";
      when "release" =>
         for Object_Dir use "obj-release";
         for Exec_Dir use "bin-release";
      when "fast" =>
         for Object_Dir use "obj-fast";
         for Exec_Dir use "bin-fast";
   end case;
   for Create_Missing_Dirs use "True";
   for Main use ("body_driver.adb", "selftest.adb", "replay.adb", "frame.adb", "score.adb", "numbers.adb", "deadcode.adb", "proxy.adb",
                 "feed.adb", "brain_measure.adb", "brain_scene.adb", "fake_brain.adb", "world_check.adb",
                 "action_matrix.adb", "contact_matrix.adb", "truth_warp.adb", "align_study.adb",
                 "grammar_dump.adb", "driver-robot-fit_replay.adb", "driver-robot-walk_replay.adb",
                 "driver-robot-flow_replay.adb", "pool_bench.adb");

   --  No loop peeled or versioned for its arrays' alignment: a vectorized loop whose first elements were done apart
   --  where an array happened to lie off the vector's width, its multiply-adds fused in one part and not the other, left
   --  a fit's sums a bit apart from run to run of the same program on the same input (RB-Y1 seed 3b's first fit,
   --  replayed serially on the big machine, 10-24: two results, 181.3658 and 181.3654 px, as the heap fell; the second
   --  descent round's cost apart in its 16th digit). Without them it gave one result in every run and at every count
   --  of workers, fused multiply-adds and vectorizing kept. And no multiply-add fused at all (-ffp-contract=off), in any
   --  build: where the compiler fused one depended on how the code around it was compiled, so a value made in two
   --  places, or in two builds, was not always the same float, and the fit leans on such values agreeing (Model_Of's
   --  Part_At; the error model's and the order search's sums). The fast build without the language's checks fused
   --  elsewhere and fitted worse: of round n32s2's 790 fit dumps against the truth (10-28), 443 within 2 % against 457
   --  with the checks (17 fits within it only with them, 3 only without: p 0.002); fusing nothing, 454 (13 against 10,
   --  p 0.5), and as fast (5834 s of CPU against 5921).
   Same_Every_Run := ("--param=vect-max-peeling-for-alignment=0", "--param=vect-max-version-for-alignment-checks=0",
                      "-ffp-contract=off");
   Common_Switches := ("-gnat2022", "-gnata", "-gnatwa", "-gnatyg", "-gnatyM120", "-O2", "-g") & Same_Every_Run;
   --  The body on a robot: without the assertions (the contracts the tests prove, checked on every call of the
   --  aligner's sampling), the language's own checks kept.
   Release_Switches := ("-gnat2022", "-gnatwa", "-gnatyg", "-gnatyM120", "-O2", "-g") & Same_Every_Run;
   --  BD_BUILD=fast: what a robot runs, optimized for the machine that builds it (-O3, its own instruction set,
   --  inlining across units), for the hall's rounds on the big machine; without the assertions and without the
   --  language's own checks (-gnatp), which no run of the driver fails (the self tests run the normal build, checks,
   --  assertions and all) and which held the code they guard from its fastest form. On the big machine (10-28) round
   --  n32s2's 790 fit dumps replayed on one worker took 5834 s of CPU against 8304 with the checks, as many of them
   --  within 2 % of the truth as with the normal build (454 against 455), and rec3/panda1's estimates 24.9 s against
   --  29.7.
   Fast_Switches := ("-gnat2022", "-gnatwa", "-gnatyg", "-gnatyM120", "-O3", "-march=native", "-gnatn", "-gnatp", "-g")
     & Same_Every_Run;

   package Compiler is
      case Build is
         when "normal" =>
            for Default_Switches ("Ada") use Common_Switches;
         when "asan" =>
            for Default_Switches ("Ada") use Common_Switches & ("-fsanitize=address", "-fno-omit-frame-pointer");
         when "profile" =>
            for Default_Switches ("Ada") use Common_Switches & ("-pg");
         when "release" =>
            for Default_Switches ("Ada") use Release_Switches;
         when "fast" =>
            for Default_Switches ("Ada") use Fast_Switches;
      end case;
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      case Build is
         when "normal" =>
            null;
         when "asan" =>
            for Default_Switches ("Ada") use ("-fsanitize=address");
         when "profile" =>
            for Default_Switches ("Ada") use ("-pg");
         when "release" | "fast" =>
            null;
      end case;
   end Linker;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=60");
   end Prove;
end Driver;
