--  The body driver: one executable, its self test and the offline replay tool.
--  Build: alr build.  Prove the SPARK units: alr exec -- gnatprove -P driver.gpr
--  BD_BUILD=asan (alr build -- -XBD_BUILD=asan) builds the same programs with
--  AddressSanitizer into obj-asan and bin-asan, for the merge gate; the
--  normal build is untouched. BD_BUILD=profile builds them with -pg into
--  obj-profile and bin-profile: a run writes gmon.out for gprof (where the
--  time of the main task went, function by function).
project Driver is
   type Build_Kind is ("normal", "asan", "profile");
   Build : Build_Kind := external ("BD_BUILD", "normal");

   for Source_Dirs use ("src/**", "tests", "tools");
   case Build is
      when "normal" =>
         for Object_Dir use "obj";
         for Exec_Dir use "bin";
      when "asan" =>
         for Object_Dir use "obj-asan";
         for Exec_Dir use "bin-asan";
      when "profile" =>
         for Object_Dir use "obj-profile";
         for Exec_Dir use "bin-profile";
   end case;
   for Create_Missing_Dirs use "True";
   for Main use ("body_driver.adb", "selftest.adb", "replay.adb", "frame.adb", "score.adb", "numbers.adb", "deadcode.adb", "proxy.adb",
                 "feed.adb", "brain_measure.adb", "brain_scene.adb", "fake_brain.adb", "world_check.adb",
                 "action_matrix.adb", "contact_matrix.adb", "truth_warp.adb", "align_study.adb");

   Common_Switches := ("-gnat2022", "-gnata", "-gnatwa", "-gnatyg", "-gnatyM120", "-O2", "-g");

   package Compiler is
      case Build is
         when "normal" =>
            for Default_Switches ("Ada") use Common_Switches;
         when "asan" =>
            for Default_Switches ("Ada") use Common_Switches & ("-fsanitize=address", "-fno-omit-frame-pointer");
         when "profile" =>
            for Default_Switches ("Ada") use Common_Switches & ("-pg");
      end case;
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      case Build is
         when "normal" =>
            null;
         when "asan" =>
            for Default_Switches ("Ada") use ("-fsanitize=address");
         when "profile" =>
            for Default_Switches ("Ada") use ("-pg");
      end case;
   end Linker;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=60");
   end Prove;
end Driver;
